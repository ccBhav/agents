{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(yarn test:*)",
      "Bash(yarn run:*)",
      "Bash(npx tsc:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.mjs"
          }
        ]
      }
    ]
  }
}